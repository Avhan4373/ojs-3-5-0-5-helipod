msgstr "Journal Template"

msgid "plugins.block.sidebarCards.section.templateHint"
msgstr "A download card for the manuscript template."

msgid "plugins.block.sidebarCards.section.tools"
msgstr "Recommended Tools"

msgid "plugins.block.sidebarCards.section.toolsHint"
msgstr "A grid of writing, reference and plagiarism-checking tools."

msgid "plugins.block.sidebarCards.section.popular"
msgstr "Popular Article"

msgid "plugins.block.sidebarCards.section.popularHint"
msgstr "Automatically lists the most viewed published articles using OJS statistics."

msgid "plugins.block.sidebarCards.section.custom"
msgstr "Custom Cards"

msgid "plugins.block.sidebarCards.section.customHint"
msgstr "Add any other card. Content accepts basic HTML."

msgid "plugins.block.sidebarCards.section.display"
msgstr "Display"

