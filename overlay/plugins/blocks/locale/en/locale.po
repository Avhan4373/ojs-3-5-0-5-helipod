msgid "plugins.block.sidebarCards.displayName"
msgstr "Sidebar Cards"

msgid "plugins.block.sidebarCards.description"
msgstr "Adds configurable sidebar cards for Chat Us, Journal Template, Recommended Tools, Popular Articles and custom cards."

msgid "plugins.block.sidebarCards.settingsIntro"
msgstr "Manage the cards shown in the journal sidebar. Cards are rendered below the main menu."

msgid "plugins.block.sidebarCards.section.chat"
msgstr "Chat Us"

